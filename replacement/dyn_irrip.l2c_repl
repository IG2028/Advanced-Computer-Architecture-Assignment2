/*
 * ============================================================================
 *  Task 2B : Dynamic I-RRIP (set dueling)        [PREFETCH_AWARE = 0]
 *  Task 3  : Prefetch-aware Dynamic I-RRIP       [PREFETCH_AWARE = 1]
 * ============================================================================
 *
 *  Both tasks live in this one file, as the assignment asks for Task 3 to be
 *  built into replacement/dyn_irrip.l2c_repl. PREFETCH_AWARE defaults to 0
 *  so `./build_champsim.sh no dyn_irrip ...` is Task 2B, and
 *  replacement/pf_dyn_irrip.l2c_repl (two lines: define PREFETCH_AWARE 1,
 *  include this file) is Task 3, so both can be built side by side.
 *
 *  Contents of this comment
 *    2B-1  The mechanism
 *    2B-2  Deliverable: number of leader sets and how they are placed
 *    2B-3  Deliverable: decision logic
 *    2B-4  Deliverable: threshold sensitivity (5 thresholds)
 *    3-1   The problem SPP creates at the L2
 *    3-2   Deliverable: how prefetch packets are handled, and why
 *  Values chosen by the tuning runs (results/tuning/tuning.md) are marked
 *  "TUNED" where they are defined.
 *
 * ============================================================== Task 2B ======
 *  2B-1  Mechanism
 * ----------------------------------------------------------------------------
 *  Two policies share the L2:
 *    SRRIP  : insert every fill at maxRRPV-1, hit -> 0, evict first line at
 *             maxRRPV (rrip.l2c_repl).
 *    I-RRIP : the Task 2A policy (instruction fills nearer, data hits promote
 *             one step, data evicted before instructions at maxRRPV).
 *  I-RRIP wins when instruction misses dominate (big code footprint); SRRIP
 *  wins in data-heavy phases, where I-RRIP's extra protection of instruction
 *  lines costs data hits for nothing. Set dueling measures both on a sample
 *  of sets and runs the better one on the rest.
 *
 *  Sets are split into three groups:
 *    - DIRRIP_LEADER_SETS "SRRIP leader" sets that always run SRRIP
 *    - DIRRIP_LEADER_SETS "I-RRIP leader" sets that always run I-RRIP
 *    - follower sets, which run whichever policy the decision logic picks
 *      (a single global 1-bit selector).
 *
 *  On every demand access (LOAD / RFO / LOAD_TRANSLATION) to a leader set we
 *  count, per leader kind, instruction and total accesses and misses.
 *  Every DIRRIP_EPOCH_ACCESSES demand accesses the followers' policy is
 *  recomputed, then all counters are halved, so the decision follows program
 *  phases (the last ~2 epochs dominate) and counters never saturate.
 *
 * ----------------------------------------------------------------------------
 *  2B-2  Deliverable: leader sets
 * ----------------------------------------------------------------------------
 *    16 SRRIP leaders + 16 I-RRIP leaders out of 1,024 sets (3.1%).
 *    (TUNED, was 32 + 32.)
 *    - Placement (complement-select, as in DIP, Qureshi et al. ISCA 2007):
 *      the 1,024 sets form 16 regions of 64 consecutive sets; in region r the
 *      set at offset r is an SRRIP leader and the set at offset 63-r is an
 *      I-RRIP leader. Every region has one of each, so both samples cover the
 *      whole index space (code and data addresses map all over it), and the
 *      two never collide (r = 63-r has no integer solution). The kind of a set
 *      is a function of its index bits, so it costs no storage.
 *    - Why 16 per policy. Leaders cost performance: they are pinned to one
 *      policy, and in any phase half of them run the losing one. They buy
 *      decision accuracy, but the decision only needs the instruction share
 *      R measured on the SRRIP leaders (2B-3), and R is far from the
 *      threshold on two of the three traces (0.27 and 0.60 vs 0.40). With 16
 *      leaders, a 16K-access epoch puts ~256 demand accesses in the SRRIP
 *      group, and halving the counters keeps about two epochs, so R is
 *      estimated from ~500 samples: a standard error of about
 *      sqrt(0.25/500) = 0.02, well below those distances. Only Trace1
 *      (R ~ 0.43-0.45) sits close enough to flip, and Trace1 is the trace
 *      where SRRIP and I-RRIP perform within 0.1% of each other, so a noisy
 *      choice there costs nothing.
 *    - Tuning (t2b_leaders, with the original decision logic): 16 leaders
 *      1.0076, 32 leaders 1.0062, 64 leaders 1.0066 geomean speedup. With the
 *      tuned ratio-only decision, 16 and 32 leaders give the same 1.0077, so
 *      16 is kept for pinning half as many sets at equal decision quality.
 *    - The I-RRIP leaders are not used by the tuned decision (ratio only).
 *      They stay because modes 1 and 2 need them and the stats print both
 *      policies' miss rates from them; they run I-RRIP, which is the policy
 *      the followers use most of the time anyway.
 *
 * ----------------------------------------------------------------------------
 *  2B-3  Deliverable: decision logic
 * ----------------------------------------------------------------------------
 *    ratio (the spec's formula, measured on the SRRIP leaders):
 *        R = (A_instr + M_instr) / (A_total + M_total)
 *        (DIRRIP_RATIO_MISS_WEIGHT w = 1 reproduces the spec formula; the
 *        misses count twice in effect, because a miss is also an access, so
 *        R grows faster when instruction lines are being lost.)
 *        Measured on the SRRIP leaders because that is the unprotected
 *        behaviour: it says how much instruction pressure there is before
 *        I-RRIP hides some of it. On the I-RRIP leaders R would drop as soon
 *        as I-RRIP works, and the selector would oscillate.
 *        Followers run I-RRIP if R > T, with a relative hysteresis band:
 *        switch to I-RRIP above T*1.05, back to SRRIP below T*0.95, so the
 *        selector does not flip every epoch when R sits on T.
 *        T = 0.40 (TUNED, was 0.25; see 2B-4).
 *
 *    DIRRIP_DECISION_MODE 0: ratio only (the spec's rule)   <- TUNED, was 2
 *                         1: duel guard only (classic set dueling)
 *                         2: ratio AND duel guard
 *    The duel guard compares cost = c*M_instr + M_data on both leader groups
 *    and allows I-RRIP only if its leaders are no more than 2% costlier.
 *    It was the original default and tuning removed it:
 *      mode 2 (ratio AND guard, T 0.25)   1.0062
 *      mode 1 (guard only)                1.0063
 *      mode 0 (ratio only,  T 0.25)       1.0075
 *      mode 0 (ratio only,  T 0.40)       1.0077   <- chosen
 *    Why the guard hurt: it counts misses, and I-RRIP always shows more data
 *    misses than it saves instruction misses (on Trace2, over the whole run,
 *    I-RRIP leaders had 350 fewer instruction misses and 2,655 more data
 *    misses than SRRIP leaders), so it vetoed I-RRIP in 69% of Trace2's
 *    epochs although static I-RRIP is 2.4% faster there. Raising the
 *    instruction-miss weight c to 4 or 8 helped only marginally (1.0065):
 *    miss counts do not capture that an instruction miss stalls the whole
 *    front end. The instruction share R is the better signal here: when it
 *    is high, protecting instructions pays even if the miss count goes up
 *    (the Task 2A results show the same thing).
 *
 * ----------------------------------------------------------------------------
 *  2B-4  Deliverable: sensitivity to the threshold (5 values)
 * ----------------------------------------------------------------------------
 *    Ratio-only decision (the tuned logic), results of t2b_thr_ratio (run
 *    with 32 leaders; with the tuned 16 the T = 0.40 point is the same
 *    1.0077). scripts/run_sweep.sh now runs these five values:
 *                         T = 0.30     0.40     0.50     0.60     0.70
 *      geomean speedup      1.0075   1.0077   1.0076   1.0068   1.0040
 *      L2 instr MPKI        7.78     7.82     7.98     8.19     8.93
 *      L2 data MPKI         6.61     6.54     6.39     6.31     6.00
 *      I-RRIP epochs  Tr1   1.00     0.75     0.00     0.00     0.00
 *                     Tr2   0.94     0.93     0.91     0.73     0.00
 *                     Tr3   0.38     0.31     0.31     0.00     0.00
 *    Each trace leaves I-RRIP when T passes its own mean ratio (Trace3 0.27,
 *    Trace1 0.43-0.45, Trace2 0.60), which is the behaviour the rule is
 *    designed to have, and instruction MPKI rises / data MPKI falls
 *    monotonically with T. Performance has a broad plateau at 0.30-0.50 and
 *    falls off once Trace2, the trace that gains most from I-RRIP, is
 *    switched to SRRIP (0.60: partly, 0.70: entirely, -0.37%). 0.40 is the
 *    peak and sits in the middle of the plateau, so it is the most robust
 *    choice: it keeps Trace2 in I-RRIP and lets Trace1, which does slightly
 *    better with SRRIP, leave it a quarter of the time.
 *    Earlier sweep with the guard (mode 2, T = 0.05 ... 0.40, results/dynT_*)
 *    was flat (1.0059-1.0064) because the thresholds were all below the
 *    ratios of Trace1 and Trace2, so the guard alone decided; that is why
 *    the final sweep is centred on the measured ratios.
 *
 *    Dynamic vs static: tuned dynamic I-RRIP (1.0077) is above SRRIP (1.0004)
 *    and close to the old static I-RRIP (1.0081), as set dueling should be
 *    when one policy is best in most phases. Its I-RRIP half uses the Task 2A
 *    rules as they were when Task 2B was tuned (data inserted at 2, eviction
 *    tie-break only, DIRRIP_INSERT_DATA / DIRRIP_EVICT_PREFER_DATA below);
 *    the later Task 2A tuning (data at 3, eviction mode 2) was not tried
 *    inside the duel.
 *
 * =============================================================== Task 3 ======
 *  3-1  The problem
 * ----------------------------------------------------------------------------
 *  With SPP at the L1D, the L2 also sees PREFETCH packets (type == PREFETCH)
 *  from the L1D. They are speculative, they are data, and 97% of them are
 *  FILL_L1 (they also go into the L1D), so the core's later reads hit in the
 *  L1D and the L2 copy is rarely read. Treated as demand data they are
 *  inserted at RRPV 2 next to instruction lines and reused data, a prefetch
 *  request that hits in L2 is promoted as if the core had reused the line,
 *  and they inflate the dueling counters. ("SPP alone" uses LRU at L2,
 *  which is worse still: every prefetch fill becomes MRU.)
 *
 * ----------------------------------------------------------------------------
 *  3-2  Deliverable: handling of prefetch packets (PREFETCH_AWARE 1)
 * ----------------------------------------------------------------------------
 *  Applied to every set, leaders included, so the duel stays a fair
 *  I-RRIP-vs-SRRIP comparison under the same prefetch handling.
 *
 *    Insertion : a prefetch fill goes to DIRRIP_PF_INSERT_FAR (maxRRPV = 3,
 *                the first thing evicted; PACMan-M, Wu et al. MICRO 2011)
 *                unless
 *                  - the prefetch was a FILL_L2 one (the L1D MSHR was busy,
 *                    so the L2 copy is the only copy the core will read), or
 *                  - recent prefetched L2 lines have been demanded often
 *                    enough (L2 prefetch reuse >= DIRRIP_PF_REUSE_HIGH, e.g.
 *                    when the L1D thrashes and prefetched lines are re-read
 *                    from L2);
 *                in which case it goes to DIRRIP_PF_INSERT_NEAR (maxRRPV-1,
 *                same as a demand data fill).
 *    Promotion : an L1D prefetch that hits in L2 does not promote the line
 *                (PACMan-H: it is not a reuse by the core). The first demand
 *                hit on a prefetched line is treated as that line's real
 *                insertion (RRPV = demand insertion value, only ever moved
 *                closer), because that access is the miss the prefetch saved,
 *                not evidence of reuse. Later demand hits promote normally.
 *    Eviction  : among lines at maxRRPV, a prefetched line that was never
 *                demanded is evicted first, then data, then instructions.
 *                This is what protects I-RRIP's instruction lines from SPP's
 *                traffic.
 *    Dueling   : prefetch packets are never counted in the ratio or the
 *                cost, so they cannot dilute the instruction share or the
 *                miss counts the duel compares.
 *
 *  Where the "hint" comes from: no new bits on the bus. The packet already
 *  has type == PREFETCH and fill_level (FILL_L1 / FILL_L2). The fill level is
 *  read from the MSHR entry being filled (MSHR.entry[MSHR.next_fill_index],
 *  the packet that called us); if that entry does not match the address the
 *  policy falls back to the reuse rule. The per-line prefetch bit already in
 *  BLOCK says whether a line was prefetched and not yet demanded (cache.cc
 *  clears it on the first demand hit, after this policy has seen it).
 *
 *  Ideas considered and dropped (see docs/task3_pf_dyn_irrip.md): promoting
 *  on prefetch hits (exactly the pollution PACMan measured; kept only as the
 *  ablation knob DIRRIP_PF_HIT_PROMOTE), an instruction-region table and
 *  L2->L1 feedback bits (SPP prefetches data only, so instruction locality
 *  says nothing about whether a data prefetch will be reused, and SPP already
 *  measures its own accuracy at the L1D).
 *
 *  Tuning (t3_insert, t3_ablate, t3_reuse; all with SPP and dynamic I-RRIP
 *  fixed): turning any single mechanism off, inserting prefetches at 2,
 *  inserting every prefetch far, or lowering the reuse threshold to 0.03 or
 *  0.08 each cost 0.01-0.04% (geomean 1.0146-1.0150 vs 1.0150), so all
 *  defaults were kept. Each mechanism points the right way, and the effect
 *  is small because prefetch fills are a small share of L2 fills (SPP
 *  issues 46K-102K prefetches per 25M instructions) and 96-98% of the
 *  prefetched L2 lines are never demanded, which is also why the 0.5 reuse
 *  threshold never fires. Task 3 inherits the tuned SPP (256-entry ST) and
 *  the tuned Task 2B decision; the final runs measure that combination.
 * ============================================================================
 */

#include "cache.h"

// ============================================================================
// =========================  TUNABLE PARAMETERS  =============================
// ============================================================================

// ---------- Which task ----------
#ifndef PREFETCH_AWARE
#define PREFETCH_AWARE              0      // 0: Task 2B   1: Task 3
#endif

// ---------- RRPV ----------
#ifndef DIRRIP_RRPV_BITS
#define DIRRIP_RRPV_BITS            2
#endif
#define DIRRIP_MAX_RRPV             ((1U << DIRRIP_RRPV_BITS) - 1)

// ---------- I-RRIP behaviour (same meaning as in irrip.l2c_repl) ----------
#ifndef DIRRIP_INSERT_INSTR
#define DIRRIP_INSERT_INSTR         1
#endif
#ifndef DIRRIP_INSERT_DATA
#define DIRRIP_INSERT_DATA          (DIRRIP_MAX_RRPV - 1)
#endif
#ifndef DIRRIP_DATA_HIT_STEP
#define DIRRIP_DATA_HIT_STEP        1      // I-RRIP data hit: RRPV -= step (SRRIP: -> 0)
#endif
#ifndef DIRRIP_EVICT_PREFER_DATA
#define DIRRIP_EVICT_PREFER_DATA    1      // I-RRIP eviction tie-break: data before instruction at maxRRPV
#endif

// ---------- SRRIP behaviour ----------
#ifndef DIRRIP_SRRIP_INSERT
#define DIRRIP_SRRIP_INSERT         (DIRRIP_MAX_RRPV - 1)
#endif

// ---------- Writebacks (both policies) ----------
#ifndef DIRRIP_INSERT_WRITEBACK
#define DIRRIP_INSERT_WRITEBACK     (DIRRIP_MAX_RRPV - 1)
#endif
#ifndef DIRRIP_PROMOTE_ON_WB_HIT
#define DIRRIP_PROMOTE_ON_WB_HIT    0
#endif

// ---------- Set dueling ----------
// TUNED (t2b_leaders): 16 per policy, was 32 (see 2B-2)
#ifndef DIRRIP_LEADER_SETS
#define DIRRIP_LEADER_SETS          16     // leader sets PER POLICY (16 SRRIP + 16 I-RRIP of 1024 = 3.1 %)
#endif
// TUNED (t2b_mode): ratio only, was 2 = ratio AND duel guard (1.0062 -> 1.0075, see 2B-3)
#ifndef DIRRIP_DECISION_MODE
#define DIRRIP_DECISION_MODE        0      // 0 ratio only, 1 duel only, 2 ratio AND duel
#endif
// TUNED (t2b_thr_ratio): 0.40, was 0.25 (peak of the 5-point study, see 2B-4)
#ifndef DIRRIP_THRESHOLD
#define DIRRIP_THRESHOLD            0.40   // ratio threshold (the parameter of the 5-point sensitivity study)
#endif
#ifndef DIRRIP_RATIO_MISS_WEIGHT
#define DIRRIP_RATIO_MISS_WEIGHT    1.0    // w in R; 1.0 reproduces the spec formula
#endif
#ifndef DIRRIP_HYSTERESIS
#define DIRRIP_HYSTERESIS           0.05   // relative band: enter I-RRIP above T*(1+h), leave below T*(1-h)
#endif
#ifndef DIRRIP_INSTR_MISS_COST
#define DIRRIP_INSTR_MISS_COST      2.0    // (modes 1 and 2 only) c in the duel cost: an L2 instruction miss stalls fetch, a data miss is partly hidden by OoO
#endif
#ifndef DIRRIP_GUARD_MARGIN
#define DIRRIP_GUARD_MARGIN         0.02   // (modes 1 and 2 only) I-RRIP may cost up to 2 % more than SRRIP in the duel and still be allowed
#endif
#ifndef DIRRIP_EPOCH_ACCESSES
#define DIRRIP_EPOCH_ACCESSES       16384  // L2 demand accesses (all sets) between decisions
#endif
#ifndef DIRRIP_MIN_SAMPLES
#define DIRRIP_MIN_SAMPLES          64     // SRRIP-leader demand accesses needed before a decision is trusted
#endif
#ifndef DIRRIP_CTR_BITS
#define DIRRIP_CTR_BITS             16     // width of each leader counter (saturating, halved every epoch)
#endif
#ifndef DIRRIP_INIT_IRRIP
#define DIRRIP_INIT_IRRIP           0      // followers start in I-RRIP (1) or SRRIP (0)
#endif

// ---------- Task 3: prefetch awareness ----------
#ifndef DIRRIP_PF_INSERT_FAR
#define DIRRIP_PF_INSERT_FAR        DIRRIP_MAX_RRPV        // prefetch fill whose L2 copy is not expected to be read
#endif
#ifndef DIRRIP_PF_INSERT_NEAR
#define DIRRIP_PF_INSERT_NEAR       (DIRRIP_MAX_RRPV - 1)  // prefetch fill whose L2 copy is likely to be read
#endif
#ifndef DIRRIP_PF_USE_FILL_LEVEL
#define DIRRIP_PF_USE_FILL_LEVEL    1      // FILL_L2 prefetches (L2 is the only copy) insert NEAR
#endif
#ifndef DIRRIP_PF_ADAPTIVE
#define DIRRIP_PF_ADAPTIVE          1      // insert FILL_L1 prefetches NEAR when L2 prefetch reuse is high
#endif
#ifndef DIRRIP_PF_REUSE_HIGH
#define DIRRIP_PF_REUSE_HIGH        0.50   // reuse = demanded / (demanded + evicted unused) prefetched L2 lines
#endif
#ifndef DIRRIP_PF_HIT_PROMOTE
#define DIRRIP_PF_HIT_PROMOTE       0      // 1: a prefetch request hitting in L2 promotes like a data hit
#endif
#ifndef DIRRIP_PF_FIRST_USE_AS_INSERT
#define DIRRIP_PF_FIRST_USE_AS_INSERT 1    // first demand hit on a prefetched line -> demand insertion RRPV (not a promotion)
#endif
#ifndef DIRRIP_PF_EVICT_FIRST
#define DIRRIP_PF_EVICT_FIRST       1      // at maxRRPV evict never-demanded prefetched lines first
#endif
// ============================================================================
// ======================  END OF TUNABLE PARAMETERS  =========================
// ============================================================================

static_assert(L2C_SET % DIRRIP_LEADER_SETS == 0, "DIRRIP_LEADER_SETS must divide L2C_SET");
static_assert(L2C_SET / DIRRIP_LEADER_SETS >= 2, "need at least two sets per leader region");

#define DIRRIP_FOLLOWER       0
#define DIRRIP_LEADER_SRRIP   1
#define DIRRIP_LEADER_IRRIP   2
#define DIRRIP_CTR_MAX        ((1ULL << DIRRIP_CTR_BITS) - 1)

uint32_t dirrip_rrpv[L2C_SET][L2C_WAY];
uint8_t  dirrip_set_kind[L2C_SET];      // fixed by the index bits; no storage needed in hardware

// Per-leader-kind counters: [kind][0 = SRRIP leaders, 1 = I-RRIP leaders]
struct DIRRIP_LEADER_CTRS {
    uint64_t acc_instr, acc_total, miss_instr, miss_total;
};
DIRRIP_LEADER_CTRS dirrip_ctr[2];

uint64_t dirrip_epoch_ctr  = 0;
uint8_t  dirrip_follow_irrip = DIRRIP_INIT_IRRIP;   // the 1-bit policy selector for followers

// Task 3 counters (hardware too)
uint64_t dirrip_pf_used   = 0;          // prefetched L2 lines that got a demand hit
uint64_t dirrip_pf_unused = 0;          // prefetched L2 lines evicted without a demand hit
uint8_t  dirrip_pf_reuse_high = 0;      // 1-bit outcome of the last epoch

// statistics only (reset when warmup ends)
struct DIRRIP_STATS {
    uint64_t epochs, epochs_irrip, switches_to_irrip, switches_to_srrip, skipped_decisions;
    double   last_ratio, ratio_sum, last_cost_srrip, last_cost_irrip;
    uint64_t miss_instr[3], miss_data[3], acc_instr[3], acc_data[3];   // by set kind (follower, SRRIP leader, I-RRIP leader)
    uint64_t pf_fill_far, pf_fill_near_l2only, pf_fill_near_reuse, pf_hits, pf_first_use, pf_evicted_unused;
    uint64_t pf_epochs_reuse_high;
};
DIRRIP_STATS dirrip_stats;
uint8_t dirrip_stats_reset_done = 0;

static inline bool dirrip_is_instruction(uint32_t type, uint8_t isInstruction)
{
    return isInstruction && (type == LOAD || type == PREFETCH);
}

// demand = something the core is waiting for; these drive the duel
static inline bool dirrip_is_demand(uint32_t type)
{
    return type == LOAD || type == RFO || type == LOAD_TRANSLATION;
}

static inline void dirrip_sat_inc(uint64_t &c)
{
    if (c < DIRRIP_CTR_MAX)
        c++;
}

// does this set run I-RRIP right now?
static inline bool dirrip_set_uses_irrip(uint32_t set)
{
    if (dirrip_set_kind[set] == DIRRIP_LEADER_SRRIP) return false;
    if (dirrip_set_kind[set] == DIRRIP_LEADER_IRRIP) return true;
    return dirrip_follow_irrip;
}

// end-of-epoch decision
static void dirrip_decide()
{
    DIRRIP_LEADER_CTRS &s = dirrip_ctr[0];
    DIRRIP_LEADER_CTRS &i = dirrip_ctr[1];

    dirrip_stats.epochs++;

    if (s.acc_total < DIRRIP_MIN_SAMPLES) {
        dirrip_stats.skipped_decisions++;    // too little leader traffic: keep the current policy
    }
    else {
        // ---- ratio from the SRRIP leaders (spec hint) ----
        double w = DIRRIP_RATIO_MISS_WEIGHT;
        double ratio = ((double)s.acc_instr + w * (double)s.miss_instr) / ((double)s.acc_total + w * (double)s.miss_total);
        bool ratio_wants;
        if (dirrip_follow_irrip) ratio_wants = ratio >= DIRRIP_THRESHOLD * (1.0 - DIRRIP_HYSTERESIS);
        else                     ratio_wants = ratio >  DIRRIP_THRESHOLD * (1.0 + DIRRIP_HYSTERESIS);

        // ---- duel guard ----
        double c = DIRRIP_INSTR_MISS_COST;
        double cost_s = c * (double)s.miss_instr + (double)(s.miss_total - s.miss_instr);
        double cost_i = c * (double)i.miss_instr + (double)(i.miss_total - i.miss_instr);
        bool duel_ok = cost_i <= cost_s * (1.0 + DIRRIP_GUARD_MARGIN);

        (void)ratio_wants; (void)duel_ok;    // one of them is unused in modes 0 and 1
        bool want;
#if DIRRIP_DECISION_MODE == 0
        want = ratio_wants;
#elif DIRRIP_DECISION_MODE == 1
        want = duel_ok;
#else
        want = ratio_wants && duel_ok;
#endif
        if (want && !dirrip_follow_irrip) dirrip_stats.switches_to_irrip++;
        if (!want && dirrip_follow_irrip) dirrip_stats.switches_to_srrip++;
        dirrip_follow_irrip = want;

        dirrip_stats.last_ratio = ratio;
        dirrip_stats.ratio_sum += ratio;
        dirrip_stats.last_cost_srrip = cost_s;
        dirrip_stats.last_cost_irrip = cost_i;

        // decay so the next epochs dominate
        for (int k = 0; k < 2; k++) {
            dirrip_ctr[k].acc_instr  >>= 1;
            dirrip_ctr[k].acc_total  >>= 1;
            dirrip_ctr[k].miss_instr >>= 1;
            dirrip_ctr[k].miss_total >>= 1;
        }
    }
    if (dirrip_follow_irrip)
        dirrip_stats.epochs_irrip++;

#if PREFETCH_AWARE
    uint64_t seen = dirrip_pf_used + dirrip_pf_unused;
    if (seen >= DIRRIP_MIN_SAMPLES) {
        dirrip_pf_reuse_high = ((double)dirrip_pf_used / (double)seen) >= DIRRIP_PF_REUSE_HIGH;
        dirrip_pf_used >>= 1;
        dirrip_pf_unused >>= 1;
    }
    if (dirrip_pf_reuse_high)
        dirrip_stats.pf_epochs_reuse_high++;
#endif
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C: prefetch aware " << PREFETCH_AWARE
         << " leader sets " << DIRRIP_LEADER_SETS << "+" << DIRRIP_LEADER_SETS
         << " decision mode " << DIRRIP_DECISION_MODE << " threshold " << DIRRIP_THRESHOLD
         << " epoch " << DIRRIP_EPOCH_ACCESSES << endl;

    const uint32_t region = L2C_SET / DIRRIP_LEADER_SETS;
    for (uint32_t set = 0; set < L2C_SET; set++) {
        uint32_t r = (set / region) % region;
        uint32_t o = set % region;
        if (o == r)                    dirrip_set_kind[set] = DIRRIP_LEADER_SRRIP;
        else if (o == region - 1 - r)  dirrip_set_kind[set] = DIRRIP_LEADER_IRRIP;
        else                           dirrip_set_kind[set] = DIRRIP_FOLLOWER;

        for (uint32_t w = 0; w < L2C_WAY; w++)
            dirrip_rrpv[set][w] = DIRRIP_MAX_RRPV;
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (!current_set[w].valid)
            return w;

    // age the set until a line reaches maxRRPV (same for both policies)
    uint32_t oldest = 0;
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (dirrip_rrpv[set][w] > oldest)
            oldest = dirrip_rrpv[set][w];
    if (oldest < DIRRIP_MAX_RRPV) {
        uint32_t age = DIRRIP_MAX_RRPV - oldest;
        for (uint32_t w = 0; w < L2C_WAY; w++)
            dirrip_rrpv[set][w] += age;
    }

    bool irrip = dirrip_set_uses_irrip(set);
    int first_any = -1, first_data = -1, first_dead_pf = -1;
    for (uint32_t w = 0; w < L2C_WAY; w++) {
        if (dirrip_rrpv[set][w] != DIRRIP_MAX_RRPV)
            continue;
        if (first_any < 0) first_any = w;
        if (!current_set[w].instruction && first_data < 0) first_data = w;
        if (current_set[w].prefetch && !current_set[w].translation && first_dead_pf < 0)
            first_dead_pf = w;       // prefetched data line that was never demanded
    }
    assert(first_any >= 0);

#if PREFETCH_AWARE && DIRRIP_PF_EVICT_FIRST
    if (first_dead_pf >= 0)
        return first_dead_pf;
#endif
    if (irrip && DIRRIP_EVICT_PREFER_DATA && first_data >= 0)
        return first_data;
    return first_any;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (warmup_complete[cpu] && !dirrip_stats_reset_done) {
        dirrip_stats = DIRRIP_STATS();
        dirrip_stats_reset_done = 1;
    }

    bool instr = dirrip_is_instruction(type, isInstruction);
    bool irrip = dirrip_set_uses_irrip(set);
    uint8_t kind = dirrip_set_kind[set];

    // ---------------- dueling counters (demand only) ----------------
    if (dirrip_is_demand(type)) {
        if (kind != DIRRIP_FOLLOWER) {
            DIRRIP_LEADER_CTRS &c = dirrip_ctr[kind == DIRRIP_LEADER_SRRIP ? 0 : 1];
            dirrip_sat_inc(c.acc_total);
            if (instr) dirrip_sat_inc(c.acc_instr);
            if (!hit) {
                dirrip_sat_inc(c.miss_total);
                if (instr) dirrip_sat_inc(c.miss_instr);
            }
        }
        if (instr) { dirrip_stats.acc_instr[kind]++; if (!hit) dirrip_stats.miss_instr[kind]++; }
        else       { dirrip_stats.acc_data[kind]++;  if (!hit) dirrip_stats.miss_data[kind]++; }

        if (++dirrip_epoch_ctr >= DIRRIP_EPOCH_ACCESSES) {
            dirrip_epoch_ctr = 0;
            dirrip_decide();
        }
    }

    if (hit) {
        // ---------------- promotion ----------------
        if (type == WRITEBACK && !DIRRIP_PROMOTE_ON_WB_HIT)
            return;

#if PREFETCH_AWARE
        if (type == PREFETCH) {
            dirrip_stats.pf_hits++;
            if (!DIRRIP_PF_HIT_PROMOTE)
                return;                       // an L1D prefetch hitting here is not a core re-reference
        }
        else if (block[set][way].prefetch && !block[set][way].translation && type != WRITEBACK) {
            // first demand touch of a prefetched line (cache.cc clears the bit right after this call)
            dirrip_sat_inc(dirrip_pf_used);
            dirrip_stats.pf_first_use++;
#if DIRRIP_PF_FIRST_USE_AS_INSERT
            uint32_t ins = irrip ? (instr ? DIRRIP_INSERT_INSTR : DIRRIP_INSERT_DATA) : DIRRIP_SRRIP_INSERT;
            if (dirrip_rrpv[set][way] > ins)
                dirrip_rrpv[set][way] = ins;  // only ever move it closer
            return;
#endif
        }
#endif

        if (irrip) {
            if (instr)
                dirrip_rrpv[set][way] = 0;
            else
                dirrip_rrpv[set][way] = (dirrip_rrpv[set][way] > DIRRIP_DATA_HIT_STEP) ? dirrip_rrpv[set][way] - DIRRIP_DATA_HIT_STEP : 0;
        }
        else
            dirrip_rrpv[set][way] = 0;        // SRRIP hit promotion
        return;
    }

    // ---------------- insertion ----------------
#if PREFETCH_AWARE
    // block[set][way] still holds the victim here (fill_cache runs after this call)
    if (block[set][way].valid && block[set][way].prefetch && !block[set][way].translation) {
        dirrip_sat_inc(dirrip_pf_unused);
        dirrip_stats.pf_evicted_unused++;
    }

    if (type == PREFETCH) {
        bool l2_only = false;
#if DIRRIP_PF_USE_FILL_LEVEL
        uint32_t idx = MSHR.next_fill_index;
        if (idx < MSHR.SIZE && (MSHR.entry[idx].full_addr >> LOG2_BLOCK_SIZE) == (full_addr >> LOG2_BLOCK_SIZE))
            l2_only = (MSHR.entry[idx].fill_level >= FILL_L2);
#endif
        bool reuse_high = DIRRIP_PF_ADAPTIVE && dirrip_pf_reuse_high;

        if (l2_only) {
            dirrip_rrpv[set][way] = DIRRIP_PF_INSERT_NEAR;
            dirrip_stats.pf_fill_near_l2only++;
        }
        else if (reuse_high) {
            dirrip_rrpv[set][way] = DIRRIP_PF_INSERT_NEAR;
            dirrip_stats.pf_fill_near_reuse++;
        }
        else {
            dirrip_rrpv[set][way] = DIRRIP_PF_INSERT_FAR;
            dirrip_stats.pf_fill_far++;
        }
        return;
    }
#endif

    if (type == WRITEBACK)
        dirrip_rrpv[set][way] = DIRRIP_INSERT_WRITEBACK;
    else if (irrip)
        dirrip_rrpv[set][way] = instr ? DIRRIP_INSERT_INSTR : DIRRIP_INSERT_DATA;
    else
        dirrip_rrpv[set][way] = DIRRIP_SRRIP_INSERT;
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    const char *kind_name[3] = {"follower", "srrip_leader", "irrip_leader"};

    cout << endl << "L2C Dynamic I-RRIP final stats (prefetch aware " << PREFETCH_AWARE << ")" << endl;
    cout << "DIRRIP threshold: " << DIRRIP_THRESHOLD << " decision mode: " << DIRRIP_DECISION_MODE
         << " leader sets: " << DIRRIP_LEADER_SETS << "+" << DIRRIP_LEADER_SETS << " epoch: " << DIRRIP_EPOCH_ACCESSES << endl;
    cout << "DIRRIP epochs: " << dirrip_stats.epochs << " epochs_irrip: " << dirrip_stats.epochs_irrip
         << " irrip_fraction: " << (dirrip_stats.epochs ? (double)dirrip_stats.epochs_irrip / dirrip_stats.epochs : 0.0)
         << " switches_to_irrip: " << dirrip_stats.switches_to_irrip << " switches_to_srrip: " << dirrip_stats.switches_to_srrip
         << " skipped: " << dirrip_stats.skipped_decisions << endl;
    uint64_t decided = dirrip_stats.epochs - dirrip_stats.skipped_decisions;
    cout << "DIRRIP last_ratio: " << dirrip_stats.last_ratio << " mean_ratio: " << (decided ? dirrip_stats.ratio_sum / decided : 0.0)
         << " last_cost_srrip: " << dirrip_stats.last_cost_srrip << " last_cost_irrip: " << dirrip_stats.last_cost_irrip << endl;
    for (int k = 0; k < 3; k++)
        cout << "DIRRIP " << kind_name[k] << " instr_acc: " << dirrip_stats.acc_instr[k] << " instr_miss: " << dirrip_stats.miss_instr[k]
             << " data_acc: " << dirrip_stats.acc_data[k] << " data_miss: " << dirrip_stats.miss_data[k] << endl;
#if PREFETCH_AWARE
    cout << "DIRRIP pf_fill far: " << dirrip_stats.pf_fill_far << " near_l2only: " << dirrip_stats.pf_fill_near_l2only
         << " near_reuse: " << dirrip_stats.pf_fill_near_reuse << " pf_hits: " << dirrip_stats.pf_hits
         << " first_use: " << dirrip_stats.pf_first_use << " evicted_unused: " << dirrip_stats.pf_evicted_unused
         << " epochs_reuse_high: " << dirrip_stats.pf_epochs_reuse_high << endl;
#endif

    uint64_t lines = (uint64_t)L2C_SET * L2C_WAY;
    uint64_t epoch_bits = 0;
    while ((1ULL << epoch_bits) <= (uint64_t)DIRRIP_EPOCH_ACCESSES) epoch_bits++;
    uint64_t ctr_bits = 2 * 4 * DIRRIP_CTR_BITS + epoch_bits + 1 /*policy bit*/;
    uint64_t pf_bits  = PREFETCH_AWARE ? (lines /*prefetch bit*/ + 2 * DIRRIP_CTR_BITS + 1) : 0;
    cout << "DIRRIP storage: RRPV " << lines * DIRRIP_RRPV_BITS << " bits, instruction bit " << lines
         << " bits, dueling counters " << ctr_bits << " bits, prefetch awareness " << pf_bits
         << " bits, TOTAL " << lines * DIRRIP_RRPV_BITS + lines + ctr_bits + pf_bits << " bits" << endl;
}
