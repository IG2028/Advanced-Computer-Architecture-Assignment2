/*
 * ============================================================================
 *  Task 2A : Instruction-conscious RRIP (I-RRIP) for the L2C
 * ============================================================================
 *
 *  Deliverable: the rationale behind modifying insertion, promotion and
 *  eviction, and why this combination is the best one we found. Values
 *  chosen by the tuning runs (results/tuning/tuning.md, experiments
 *  t2a_insert, t2a_promo, t2a_evict) are marked "TUNED" where they are
 *  defined.
 *
 *  Base: SRRIP from rrip.l2c_repl (2-bit RRPV, insert at maxRRPV-1 = 2,
 *  hit -> 0, evict a line at maxRRPV = 3 after ageing the set).
 *
 *  Why instructions deserve priority at the L2
 *  -------------------------------------------
 *  An instruction miss stalls the front end: nothing behind it can even be
 *  fetched. A data miss is partly hidden by the out-of-order window, since
 *  independent loads and other work proceed under it. The instruction
 *  footprint of these traces is far larger than the 32 KB L1I (L2
 *  instruction MPKI up to 19 under LRU), so the L2 is the level that serves
 *  it. I-RRIP therefore deliberately trades data hits for instruction hits,
 *  and the tuning results below show the trade pays even when the TOTAL
 *  number of L2 misses goes up.
 *
 *  Insertion  (MODIFIED)
 *  ---------------------
 *    instruction fill -> RRPV 1          data fill -> RRPV 3 (maxRRPV)
 *    writeback fill   -> RRPV 2
 *    - Data at maxRRPV (TUNED, was 2): a data line enters as the next
 *      eviction candidate of its set and survives only if it is re-referenced
 *      before the set needs a victim. Most L2 data lines are streaming or
 *      already filtered by the L1D, so they have no second use at L2; this is
 *      the bimodal/distant insertion idea of BRRIP and DIP applied to data
 *      only. Measured alone (t2a_insert): instruction MPKI 7.67 -> 6.74, data
 *      MPKI 6.62 -> 7.43, speedup 1.0081 -> 1.0100.
 *    - Instructions at 1, not 0: an instruction line at 0 would need three
 *      full ageing rounds to become evictable even if it is never used again
 *      (straight-line code that runs once), which turns priority into
 *      pinning. At 1 it outlives the data inserted with it by two ageing
 *      rounds, enough for loop bodies and hot functions to be re-referenced
 *      and promoted. Tested: inserting at 0 was worse (1.0075 vs 1.0081).
 *    - Writebacks stay at 2: a dirty line written back from L1D may be
 *      re-read, but it is not a demand, so it gets the neutral SRRIP value.
 *
 *  Promotion  (MODIFIED)
 *  ---------------------
 *    instruction hit -> RRPV 0           data hit -> RRPV - 1
 *    writeback hit   -> no change
 *    - An instruction hit is proof of reuse of the expensive kind, so it gets
 *      full protection at once (hit priority).
 *    - A data line climbs one step per hit (frequency priority). Inserted at
 *      3, it needs one hit to reach the neutral value 2 and three to reach 0,
 *      so only data that is actually reused repeatedly competes with
 *      instruction lines; hot data still gets there, so it is not starved.
 *      Tested: SRRIP-style "data hit -> 0" (1.0075) and a 2-step jump
 *      (1.0074) both lost to one step (1.0081), because they let data lines
 *      that are touched once more and then die sit above instruction lines.
 *    - Writeback hits do not promote: a writeback means the L1D is evicting
 *      the line, which is evidence it is NOT being used right now (SRRIP in
 *      rrip.l2c_repl promoted on it).
 *
 *  Eviction  (MODIFIED)
 *  --------------------
 *    The set is aged exactly like SRRIP until some line reaches RRPV 3. Then
 *    the victim is, in order of preference:
 *      1. a data line at RRPV 3
 *      2. a data line at RRPV 2, if only instruction lines are at 3
 *      3. the first line at RRPV 3 (an instruction line)
 *    (IRRIP_EVICT_MODE 2, TUNED, was 1 = rules 1 and 3 only.)
 *    - Rule 1 is a pure tie-break: it never evicts a line SRRIP would
 *      consider younger, it only uses the instruction bit to choose among
 *      equally old lines.
 *    - Rule 2 goes further and spares an instruction line at 3 when a data
 *      line one step younger exists. It overrides the RRPV order by one
 *      step, so an instruction line that really is dead still goes once no
 *      data line is at 2 or 3; it cannot be pinned. Measured alone
 *      (t2a_evict): instruction MPKI 7.67 -> 6.32, speedup 1.0081 -> 1.0133,
 *      the largest single gain of the Task 2A experiments. Without any
 *      tie-break (plain SRRIP victim choice) speedup falls to 1.0062.
 *
 *  Why this combination is the best one we found
 *  ---------------------------------------------
 *  Every change toward SRRIP behaviour lost (data hit -> 0, 2-step promotion,
 *  no tie-break, instructions at 0), and both changes toward stronger
 *  instruction priority won. Together (task2a_final run) they give:
 *                      speedup   L2 instr MPKI   L2 data MPKI   L2 MPKI
 *      SRRIP           1.0004        9.85            5.96        15.81
 *      I-RRIP (old)    1.0081        7.67            6.62        14.29
 *      I-RRIP (tuned)  1.0135        6.20            8.15        14.35
 *  The tuned policy has slightly MORE total L2 misses than the untuned one
 *  and is still 0.5% faster, because it replaces 1.5 instruction MPKI with
 *  1.5 data MPKI and an instruction miss costs more cycles than a data miss.
 *  Per trace: Trace2 (largest instruction footprint) +3.7%, Trace3 +0.7%,
 *  Trace1 -0.3% (its data misses are the expensive ones; this is exactly
 *  the case Task 2B's dynamic policy is for).
 *
 *  isInstruction
 *  -------------
 *  update_replacement_state got a new argument, isInstruction, in every cache
 *  and every policy (inc/cache.h, src/cache.cc, replacement/*). cache.cc
 *  passes the packet's `instruction` flag at every call site; the BTB passes
 *  0. A line counts as an instruction line only for LOAD / PREFETCH packets,
 *  the same rule fill_cache() uses to set block.instruction and main.cc uses
 *  for "L2C INSTRUCTION LOAD MPKI" (address-translation packets count as
 *  data). At eviction the policy reads block.instruction of each way.
 *
 *  Storage: 2-bit RRPV + 1 instruction bit per line = 3 x 8,192 = 24,576
 *  bits, i.e. one bit per line more than SRRIP.
 * ============================================================================
 */

#include "cache.h"

// ============================================================================
// =========================  TUNABLE PARAMETERS  =============================
// ============================================================================
#ifndef IRRIP_RRPV_BITS
#define IRRIP_RRPV_BITS          2     // M; maxRRPV = 2^M - 1 (2 -> 3, 3 -> 7)
#endif
#define IRRIP_MAX_RRPV           ((1U << IRRIP_RRPV_BITS) - 1)

// Insertion
#ifndef IRRIP_INSERT_INSTR
#define IRRIP_INSERT_INSTR       1     // RRPV for an instruction fill (0 = most protected)
#endif
// TUNED (t2a_insert): data fills at maxRRPV, was maxRRPV-1 (speedup 1.0081 -> 1.0100 alone)
#ifndef IRRIP_INSERT_DATA
#define IRRIP_INSERT_DATA        IRRIP_MAX_RRPV         // RRPV for a data / translation fill
#endif
#ifndef IRRIP_INSERT_WRITEBACK
#define IRRIP_INSERT_WRITEBACK   (IRRIP_MAX_RRPV - 1)   // RRPV when a writeback allocates in L2
#endif

// Promotion
#ifndef IRRIP_HIT_INSTR_RRPV
#define IRRIP_HIT_INSTR_RRPV     0     // RRPV after an instruction hit
#endif
#ifndef IRRIP_DATA_HIT_MODE
#define IRRIP_DATA_HIT_MODE      1     // 0: data hit -> RRPV 0 (SRRIP-HP)   1: data hit -> RRPV - IRRIP_DATA_HIT_STEP
#endif
#ifndef IRRIP_DATA_HIT_STEP
#define IRRIP_DATA_HIT_STEP      1     // how far one data hit moves the line (mode 1)
#endif
#ifndef IRRIP_PROMOTE_ON_WB_HIT
#define IRRIP_PROMOTE_ON_WB_HIT  0     // 1: writeback hits promote like data hits (rrip.l2c_repl behaviour)
#endif

// Eviction
// TUNED (t2a_evict): mode 2, was 1 (speedup 1.0081 -> 1.0133 alone; mode 0 gives 1.0062)
#ifndef IRRIP_EVICT_MODE
#define IRRIP_EVICT_MODE         2     // 0: first line at maxRRPV (plain SRRIP)
                                       // 1: among lines at maxRRPV prefer data over instruction
                                       // 2: as 1, and a data line at maxRRPV-1 beats an instruction line at maxRRPV
#endif
// ============================================================================
// ======================  END OF TUNABLE PARAMETERS  =========================
// ============================================================================

uint32_t irrip_rrpv[L2C_SET][L2C_WAY];

// statistics only (reset when warmup ends)
struct IRRIP_STATS {
    uint64_t fill_instr, fill_data, fill_wb;
    uint64_t hit_instr, hit_data, hit_wb;
    uint64_t evict_instr, evict_data, evict_invalid;
    uint64_t evict_tiebreak_used;     // a data line was chosen although an instruction line was found first
};
IRRIP_STATS irrip_stats;
uint8_t irrip_stats_reset_done = 0;

static inline bool irrip_is_instruction(uint32_t type, uint8_t isInstruction)
{
    return isInstruction && (type == LOAD || type == PREFETCH);
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP state for L2C: RRPV bits " << IRRIP_RRPV_BITS
         << " insert instr " << IRRIP_INSERT_INSTR << " insert data " << IRRIP_INSERT_DATA
         << " data hit mode " << IRRIP_DATA_HIT_MODE << " evict mode " << IRRIP_EVICT_MODE << endl;

    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            irrip_rrpv[i][j] = IRRIP_MAX_RRPV;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // an empty way is always the best victim
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (!current_set[w].valid) {
            irrip_stats.evict_invalid++;
            return w;
        }

    // age the set until at least one line reaches maxRRPV
    // (same result as SRRIP's "increment everyone and rescan" loop, done in one step)
    uint32_t oldest = 0;
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (irrip_rrpv[set][w] > oldest)
            oldest = irrip_rrpv[set][w];
    if (oldest < IRRIP_MAX_RRPV) {
        uint32_t age = IRRIP_MAX_RRPV - oldest;
        for (uint32_t w = 0; w < L2C_WAY; w++)
            irrip_rrpv[set][w] += age;
    }

    int first_any = -1, first_data = -1, near_data = -1;
    for (uint32_t w = 0; w < L2C_WAY; w++) {
        bool is_instr = current_set[w].instruction;
        if (irrip_rrpv[set][w] == IRRIP_MAX_RRPV) {
            if (first_any < 0) first_any = w;
            if (!is_instr && first_data < 0) first_data = w;
        }
        else if (irrip_rrpv[set][w] == IRRIP_MAX_RRPV - 1 && !is_instr && near_data < 0)
            near_data = w;
    }
    assert(first_any >= 0);

    int victim = first_any;
#if IRRIP_EVICT_MODE >= 1
    if (first_data >= 0)
        victim = first_data;
#endif
#if IRRIP_EVICT_MODE >= 2
    if (first_data < 0 && near_data >= 0)
        victim = near_data;          // only instruction lines are at maxRRPV: spare them, take a near-distant data line
#endif
    if (victim != first_any)
        irrip_stats.evict_tiebreak_used++;

    if (current_set[victim].instruction) irrip_stats.evict_instr++;
    else                                 irrip_stats.evict_data++;

    return victim;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (warmup_complete[cpu] && !irrip_stats_reset_done) {
        irrip_stats = IRRIP_STATS();
        irrip_stats_reset_done = 1;
    }

    bool instr = irrip_is_instruction(type, isInstruction);

    if (hit) {
        // ---------------- promotion ----------------
        if (type == WRITEBACK) {
            irrip_stats.hit_wb++;
            if (!IRRIP_PROMOTE_ON_WB_HIT)
                return;              // a writeback is not a re-reference by the core
        }
        if (instr) {
            irrip_stats.hit_instr++;
            irrip_rrpv[set][way] = IRRIP_HIT_INSTR_RRPV;
        }
        else {
            if (type != WRITEBACK)
                irrip_stats.hit_data++;
#if IRRIP_DATA_HIT_MODE == 0
            irrip_rrpv[set][way] = 0;
#else
            irrip_rrpv[set][way] = (irrip_rrpv[set][way] > IRRIP_DATA_HIT_STEP) ? irrip_rrpv[set][way] - IRRIP_DATA_HIT_STEP : 0;
#endif
        }
        return;
    }

    // ---------------- insertion ----------------
    if (type == WRITEBACK) {
        irrip_stats.fill_wb++;
        irrip_rrpv[set][way] = IRRIP_INSERT_WRITEBACK;
    }
    else if (instr) {
        irrip_stats.fill_instr++;
        irrip_rrpv[set][way] = IRRIP_INSERT_INSTR;
    }
    else {
        irrip_stats.fill_data++;
        irrip_rrpv[set][way] = IRRIP_INSERT_DATA;
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << endl << "L2C I-RRIP final stats" << endl;
    cout << "IRRIP fills instr: " << irrip_stats.fill_instr << " data: " << irrip_stats.fill_data << " writeback: " << irrip_stats.fill_wb << endl;
    cout << "IRRIP hits instr: " << irrip_stats.hit_instr << " data: " << irrip_stats.hit_data << " writeback: " << irrip_stats.hit_wb << endl;
    cout << "IRRIP evictions instr: " << irrip_stats.evict_instr << " data: " << irrip_stats.evict_data
         << " invalid: " << irrip_stats.evict_invalid << " tiebreak_used: " << irrip_stats.evict_tiebreak_used << endl;
    uint64_t lines = (uint64_t)L2C_SET * L2C_WAY;
    cout << "IRRIP storage: RRPV " << lines << " x " << IRRIP_RRPV_BITS << " b = " << lines * IRRIP_RRPV_BITS
         << " bits, instruction bit " << lines << " x 1 b = " << lines << " bits, TOTAL " << lines * (IRRIP_RRPV_BITS + 1) << " bits" << endl;
}