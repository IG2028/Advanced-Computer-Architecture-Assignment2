/*
 * ============================================================================
 *  Task 2A : Instruction-conscious RRIP (I-RRIP) for the L2C
 * ============================================================================
 *
 *  Contents of this comment
 *    A. The policy, and the reasoning behind each of its three parts
 *       (insertion, promotion, eviction) — the Task 2A deliverable
 *    B. The isInstruction plumbing
 *    C. Storage
 *    D. Tunable parameters and which are worth tuning
 *    E. Results on the three traces and how they match the design
 *    F. Tuning experiments (scripts/tune.py)
 *
 * ----------------------------------------------------------------------------
 *  A. Policy
 * ----------------------------------------------------------------------------
 *  Base: SRRIP from rrip.l2c_repl (2-bit RRPV, insert at maxRRPV-1 = 2,
 *  hit -> 0, evict a line at maxRRPV = 3 after ageing the set).
 *
 *  Why instructions deserve priority at the L2: an instruction miss stalls
 *  the front end, so nothing behind it can even be fetched, while a data miss
 *  is partly hidden by the out-of-order window (other independent loads and
 *  work proceed under it). The instruction footprint of these traces is far
 *  larger than the 32 KB L1I (L2 instruction MPKI 1-19 under LRU), so the L2
 *  is the level that serves it. I-RRIP therefore trades some data hits for
 *  instruction hits.
 *
 *  I-RRIP changes all three parts of the policy so that instruction lines
 *  outlive data lines:
 *
 *    Insertion : instruction fills get RRPV 1 (IRRIP_INSERT_INSTR); data
 *                fills keep the SRRIP value 2 (IRRIP_INSERT_DATA).
 *                Why 1 and not 0: an instruction line inserted at 0 would
 *                need three full ageing rounds to become evictable even if it
 *                is never used again (straight-line code that runs once),
 *                which turns a priority into pinning. At 1 it survives one
 *                more ageing round than a data line, which is enough for loop
 *                bodies and hot functions to be re-referenced and promoted.
 *                Why data stays at 2: data are not pushed further than SRRIP
 *                would push them, so a data line is never worse off than under
 *                SRRIP at the moment it enters; the bias comes only from
 *                moving instructions closer. (t2a_insert tests both
 *                alternatives: instructions at 0, data at 3.)
 *                Writeback fills also stay at 2: a dirty line written back
 *                from L1D may be re-read, but it is not a demand.
 *
 *    Promotion : an instruction hit goes to RRPV 0; a data hit moves one step
 *                closer (RRPV - 1) instead of jumping to 0. A data line thus
 *                needs two hits to reach the protection one instruction hit
 *                buys — frequency-based promotion for data, hit-priority for
 *                instructions. Data lines that are really hot still get to 0,
 *                so this does not starve hot data; it stops a data line that
 *                is touched once more and then dies from sitting at 0 above
 *                instruction lines. Writeback hits do not promote at all: a
 *                writeback is the L1D evicting the line, which is evidence it
 *                is NOT being used right now (SRRIP in rrip.l2c_repl promoted
 *                on it). (t2a_promo tests "data hit -> 0" and a 2-step jump.)
 *
 *    Eviction  : the set is aged exactly like SRRIP until a line reaches
 *                RRPV 3, but when several lines are at 3, a data line is
 *                evicted before an instruction line (IRRIP_EVICT_MODE 1).
 *                Plain SRRIP takes the first line at 3, whatever it holds.
 *                This is the cheapest way to use the per-line instruction bit
 *                at eviction: it never evicts a line that SRRIP would
 *                consider younger, it only breaks ties. On Trace2 it changed
 *                the victim 147,612 times. Mode 2 (also prefer a data line at
 *                2 over an instruction line at 3) is stronger and is left as
 *                an experiment (t2a_evict), because it overrides the RRPV
 *                order and can keep dead instruction lines alive.
 *
 *  Invalid ways are always used first, as in every ChampSim policy.
 *  Ageing is done in one step (add maxRRPV - oldest to every line), which is
 *  equivalent to SRRIP's "increment all and rescan" loop.
 *
 * ----------------------------------------------------------------------------
 *  B. isInstruction
 * ----------------------------------------------------------------------------
 *  update_replacement_state got a new argument, isInstruction, in every cache
 *  and every policy (inc/cache.h, src/cache.cc, replacement/*). cache.cc
 *  passes the packet's `instruction` flag at every call site (fills, hits,
 *  writebacks, prefetches); the BTB passes 0. A line counts as an instruction
 *  line only for LOAD / PREFETCH packets, which is the same rule
 *  fill_cache() uses to set block.instruction and the rule main.cc uses for
 *  "L2C INSTRUCTION LOAD MPKI" (address-translation packets therefore count
 *  as data). At eviction the policy reads block.instruction of each way.
 *
 * ----------------------------------------------------------------------------
 *  C. Storage (512 KB, 8-way L2 = 1,024 sets x 8 ways = 8,192 lines)
 * ----------------------------------------------------------------------------
 *    RRPV            8,192 x 2 bits = 16,384 bits (same as SRRIP)
 *    instruction bit 8,192 x 1 bit  =  8,192 bits (new)
 *    TOTAL                            24,576 bits = 3 KB, i.e. +8,192 bits
 *    over SRRIP, 0.2% of the L2 data array. No other state.
 *
 * ----------------------------------------------------------------------------
 *  D. Tunable parameters
 * ----------------------------------------------------------------------------
 *    Worth tuning: IRRIP_INSERT_INSTR, IRRIP_INSERT_DATA, IRRIP_DATA_HIT_MODE,
 *    IRRIP_DATA_HIT_STEP, IRRIP_EVICT_MODE (each changes one of the three
 *    parts above; values with 2-bit RRPVs are few, so every alternative is a
 *    single experiment point).
 *    Fixed: IRRIP_RRPV_BITS stays 2 to compare with the SRRIP baseline at the
 *    same storage; IRRIP_HIT_INSTR_RRPV = 0 is the point of the policy;
 *    IRRIP_INSERT_WRITEBACK and IRRIP_PROMOTE_ON_WB_HIT follow from "a
 *    writeback is not a demand" and only matter on write-heavy phases.
 *
 * ----------------------------------------------------------------------------
 *  E. Results (results/tables.md, 25M + 25M instructions)
 * ----------------------------------------------------------------------------
 *               speedup               L2C instr MPKI           L2C data MPKI
 *          lru(base) srrip irrip   lru   srrip  irrip      lru   srrip  irrip
 *  Trace1    1     0.9995 0.9995  10.34  10.56   9.77      7.36   7.08   7.88
 *  Trace2    1     1.0026 1.0244  18.85  17.78  12.27      8.50   7.96   9.13
 *  Trace3    1     0.9991 1.0004   1.12   1.20   0.96      2.83   2.84   2.87
 *  mean      1     1.0004 1.0081  10.11   9.85   7.66      6.23   5.96   6.62
 *  Exactly the intended trade: instruction MPKI drops 24% on average (35% on
 *  Trace2), data MPKI rises 6-7%, total L2 MPKI drops 13%, and IPC follows
 *  the instruction side because an instruction miss costs more than a data
 *  miss. Trace2 (largest instruction footprint) gains 2.4%; Trace3, whose
 *  instruction MPKI is already ~1, has nothing to gain, and Trace1 breaks
 *  even because its extra data misses cost about what its saved instruction
 *  misses gain. Plain SRRIP alone does almost nothing (+0.04%), so the gain
 *  comes from the instruction awareness, not from RRIP itself.
 *
 * ----------------------------------------------------------------------------
 *  F. Tuning experiments (no prefetcher, so the L2 sees only demand traffic)
 * ----------------------------------------------------------------------------
 *    t2a_insert  instructions at 0; data at 3
 *    t2a_promo   data hit -> 0 (SRRIP-HP for data); data hit -2
 *    t2a_evict   mode 0 (no tie-break: isolates its contribution); mode 2
 * ============================================================================
 */

#include "cache.h"

// ============================================================================
// =========================  TUNABLE PARAMETERS  =============================
// ============================================================================
#ifndef IRRIP_RRPV_BITS
#define IRRIP_RRPV_BITS          2     // M; maxRRPV = 2^M - 1 (2 -> 3, 3 -> 7)
#endif
#define IRRIP_MAX_RRPV           ((1U << IRRIP_RRPV_BITS) - 1)

// Insertion
#ifndef IRRIP_INSERT_INSTR
#define IRRIP_INSERT_INSTR       1     // RRPV for an instruction fill (0 = most protected)
#endif
#ifndef IRRIP_INSERT_DATA
#define IRRIP_INSERT_DATA        (IRRIP_MAX_RRPV - 1)   // RRPV for a data / translation fill (SRRIP value)
#endif
#ifndef IRRIP_INSERT_WRITEBACK
#define IRRIP_INSERT_WRITEBACK   (IRRIP_MAX_RRPV - 1)   // RRPV when a writeback allocates in L2
#endif

// Promotion
#ifndef IRRIP_HIT_INSTR_RRPV
#define IRRIP_HIT_INSTR_RRPV     0     // RRPV after an instruction hit
#endif
#ifndef IRRIP_DATA_HIT_MODE
#define IRRIP_DATA_HIT_MODE      1     // 0: data hit -> RRPV 0 (SRRIP-HP)   1: data hit -> RRPV - IRRIP_DATA_HIT_STEP
#endif
#ifndef IRRIP_DATA_HIT_STEP
#define IRRIP_DATA_HIT_STEP      1     // how far one data hit moves the line (mode 1)
#endif
#ifndef IRRIP_PROMOTE_ON_WB_HIT
#define IRRIP_PROMOTE_ON_WB_HIT  0     // 1: writeback hits promote like data hits (rrip.l2c_repl behaviour)
#endif

// Eviction
#ifndef IRRIP_EVICT_MODE
#define IRRIP_EVICT_MODE         1     // 0: first line at maxRRPV (plain SRRIP)
                                       // 1: among lines at maxRRPV prefer data over instruction
                                       // 2: as 1, and a data line at maxRRPV-1 beats an instruction line at maxRRPV
#endif
// ============================================================================
// ======================  END OF TUNABLE PARAMETERS  =========================
// ============================================================================

uint32_t irrip_rrpv[L2C_SET][L2C_WAY];

// statistics only (reset when warmup ends)
struct IRRIP_STATS {
    uint64_t fill_instr, fill_data, fill_wb;
    uint64_t hit_instr, hit_data, hit_wb;
    uint64_t evict_instr, evict_data, evict_invalid;
    uint64_t evict_tiebreak_used;     // a data line was chosen although an instruction line was found first
};
IRRIP_STATS irrip_stats;
uint8_t irrip_stats_reset_done = 0;

static inline bool irrip_is_instruction(uint32_t type, uint8_t isInstruction)
{
    return isInstruction && (type == LOAD || type == PREFETCH);
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize I-RRIP state for L2C: RRPV bits " << IRRIP_RRPV_BITS
         << " insert instr " << IRRIP_INSERT_INSTR << " insert data " << IRRIP_INSERT_DATA
         << " data hit mode " << IRRIP_DATA_HIT_MODE << " evict mode " << IRRIP_EVICT_MODE << endl;

    for (int i = 0; i < L2C_SET; i++)
        for (int j = 0; j < L2C_WAY; j++)
            irrip_rrpv[i][j] = IRRIP_MAX_RRPV;
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // an empty way is always the best victim
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (!current_set[w].valid) {
            irrip_stats.evict_invalid++;
            return w;
        }

    // age the set until at least one line reaches maxRRPV
    // (same result as SRRIP's "increment everyone and rescan" loop, done in one step)
    uint32_t oldest = 0;
    for (uint32_t w = 0; w < L2C_WAY; w++)
        if (irrip_rrpv[set][w] > oldest)
            oldest = irrip_rrpv[set][w];
    if (oldest < IRRIP_MAX_RRPV) {
        uint32_t age = IRRIP_MAX_RRPV - oldest;
        for (uint32_t w = 0; w < L2C_WAY; w++)
            irrip_rrpv[set][w] += age;
    }

    int first_any = -1, first_data = -1, near_data = -1;
    for (uint32_t w = 0; w < L2C_WAY; w++) {
        bool is_instr = current_set[w].instruction;
        if (irrip_rrpv[set][w] == IRRIP_MAX_RRPV) {
            if (first_any < 0) first_any = w;
            if (!is_instr && first_data < 0) first_data = w;
        }
        else if (irrip_rrpv[set][w] == IRRIP_MAX_RRPV - 1 && !is_instr && near_data < 0)
            near_data = w;
    }
    assert(first_any >= 0);

    int victim = first_any;
#if IRRIP_EVICT_MODE >= 1
    if (first_data >= 0)
        victim = first_data;
#endif
#if IRRIP_EVICT_MODE >= 2
    if (first_data < 0 && near_data >= 0)
        victim = near_data;          // only instruction lines are at maxRRPV: spare them, take a near-distant data line
#endif
    if (victim != first_any)
        irrip_stats.evict_tiebreak_used++;

    if (current_set[victim].instruction) irrip_stats.evict_instr++;
    else                                 irrip_stats.evict_data++;

    return victim;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    if (warmup_complete[cpu] && !irrip_stats_reset_done) {
        irrip_stats = IRRIP_STATS();
        irrip_stats_reset_done = 1;
    }

    bool instr = irrip_is_instruction(type, isInstruction);

    if (hit) {
        // ---------------- promotion ----------------
        if (type == WRITEBACK) {
            irrip_stats.hit_wb++;
            if (!IRRIP_PROMOTE_ON_WB_HIT)
                return;              // a writeback is not a re-reference by the core
        }
        if (instr) {
            irrip_stats.hit_instr++;
            irrip_rrpv[set][way] = IRRIP_HIT_INSTR_RRPV;
        }
        else {
            if (type != WRITEBACK)
                irrip_stats.hit_data++;
#if IRRIP_DATA_HIT_MODE == 0
            irrip_rrpv[set][way] = 0;
#else
            irrip_rrpv[set][way] = (irrip_rrpv[set][way] > IRRIP_DATA_HIT_STEP) ? irrip_rrpv[set][way] - IRRIP_DATA_HIT_STEP : 0;
#endif
        }
        return;
    }

    // ---------------- insertion ----------------
    if (type == WRITEBACK) {
        irrip_stats.fill_wb++;
        irrip_rrpv[set][way] = IRRIP_INSERT_WRITEBACK;
    }
    else if (instr) {
        irrip_stats.fill_instr++;
        irrip_rrpv[set][way] = IRRIP_INSERT_INSTR;
    }
    else {
        irrip_stats.fill_data++;
        irrip_rrpv[set][way] = IRRIP_INSERT_DATA;
    }
}

// use this function to print out your own stats at the end of simulation
void CACHE::l2c_replacement_final_stats()
{
    cout << endl << "L2C I-RRIP final stats" << endl;
    cout << "IRRIP fills instr: " << irrip_stats.fill_instr << " data: " << irrip_stats.fill_data << " writeback: " << irrip_stats.fill_wb << endl;
    cout << "IRRIP hits instr: " << irrip_stats.hit_instr << " data: " << irrip_stats.hit_data << " writeback: " << irrip_stats.hit_wb << endl;
    cout << "IRRIP evictions instr: " << irrip_stats.evict_instr << " data: " << irrip_stats.evict_data
         << " invalid: " << irrip_stats.evict_invalid << " tiebreak_used: " << irrip_stats.evict_tiebreak_used << endl;
    uint64_t lines = (uint64_t)L2C_SET * L2C_WAY;
    cout << "IRRIP storage: RRPV " << lines << " x " << IRRIP_RRPV_BITS << " b = " << lines * IRRIP_RRPV_BITS
         << " bits, instruction bit " << lines << " x 1 b = " << lines << " bits, TOTAL " << lines * (IRRIP_RRPV_BITS + 1) << " bits" << endl;
}